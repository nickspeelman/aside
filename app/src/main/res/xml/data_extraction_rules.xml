<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Runtime journal inclusion is enforced by AsideBackupAgent. Static rules remain conservative. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="file" path="datastore/manual_backup_state.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="file" path="datastore/manual_backup_state.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
