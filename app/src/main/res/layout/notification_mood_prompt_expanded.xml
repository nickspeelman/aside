<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="How are you feeling?"
        android:textSize="16sp"
        style="@style/TextAppearance.Compat.Notification.Title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:text="1 = worst, 5 = best. Add a note if you want."
        android:textSize="13sp"
        style="@style/TextAppearance.Compat.Notification" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rating_1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/notification_rating_button"
            android:contentDescription="Mood rating 1 of 5, worst"
            android:gravity="center"
            android:text="1"
            android:textSize="17sp"
            style="@style/TextAppearance.Compat.Notification.Title" />

        <TextView
            android:id="@+id/rating_2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/notification_rating_button"
            android:contentDescription="Mood rating 2 of 5"
            android:gravity="center"
            android:text="2"
            android:textSize="17sp"
            style="@style/TextAppearance.Compat.Notification.Title" />

        <TextView
            android:id="@+id/rating_3"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/notification_rating_button"
            android:contentDescription="Mood rating 3 of 5"
            android:gravity="center"
            android:text="3"
            android:textSize="17sp"
            style="@style/TextAppearance.Compat.Notification.Title" />

        <TextView
            android:id="@+id/rating_4"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/notification_rating_button"
            android:contentDescription="Mood rating 4 of 5"
            android:gravity="center"
            android:text="4"
            android:textSize="17sp"
            style="@style/TextAppearance.Compat.Notification.Title" />

        <TextView
            android:id="@+id/rating_5"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/notification_rating_button"
            android:contentDescription="Mood rating 5 of 5, best"
            android:gravity="center"
            android:text="5"
            android:textSize="17sp"
            style="@style/TextAppearance.Compat.Notification.Title" />

    </LinearLayout>

</LinearLayout>
